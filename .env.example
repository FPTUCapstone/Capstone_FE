# Server-only backend origin. Run the BE build containing Create POI and the catalogue API.
# Use HTTPS in production; HTTP is only for a local development backend.
TRIPMATE_API_BASE_URL=http://localhost:5021
# Optional public origin when a reverse proxy changes the request URL origin (no trailing path).
# TRIPMATE_WEB_ORIGIN=https://your-web.example

# Frontend Client Environment Variables (safe to expose to browser bundle)
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# UI preview only. Keep false in production until a canonical category catalogue API exists.
NEXT_PUBLIC_POI_CATEGORY_PREVIEW=false

# Firebase Web Configuration (Public Client Config - NOT secrets)
# These NEXT_PUBLIC_FIREBASE_* values are the Firebase *Web App* config that ships in the
# browser bundle. Get them from Firebase Console > Project settings > General > Your apps >
# SDK setup and configuration. They are NOT secrets. Do NOT put Firebase Admin / service-account
# credentials here - Admin verification lives in the Backend only.
#
# All keys below are REQUIRED for the app to initialize, except NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID
# (Analytics, optional). Fill the blank ones in your local .env.local; the app fails fast with a
# clear message listing any missing required key instead of an opaque initializeApp() error.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tripmate-82be3.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tripmate-82be3
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tripmate-82be3.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=105500206516
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
